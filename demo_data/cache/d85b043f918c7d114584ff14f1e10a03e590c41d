cession":"GSM2587624","title":"SAB-18 (smallRNA-Seq)"},{"accession":"GSM2587627","title":"SAB-21 (smallRNA-Seq)"}],"relations":[],"extrelations":[],"n_samples":48,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":[],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE98nnn/GSE98128/","geo2r":"no","bioproject":"PRJNA384134"},"200098126":{"uid":"200098126","accession":"GSE98126","gds":"","title":"Mapping the chemotherapy-induced RNA interactome in Glioblastoma [RNA-Seq]","summary":"Long non-coding RNAs (lncRNAs) are increasingly recognized as important players in transcription and epigenetic-driven cell diversification. So far, lncRNA function in more dynamic transcriptional reprogramming, i.e drug response, has been largely unexplored. Here, we investigated the regulatory circuits induced by chemotherapy in glioblastoma, the most aggressive and clinically refractory brain cancer. We performed a detailed characterization of the cellular and transcriptional response of glioblastoma stem-like cells to the alkylating agent temozolomide (TMZ). We found that in addition to mRNAs, TMZ affects the expression of a large number of non-coding RNAs (miRNAs, snoRNAs, lncRNAs). Our global transcriptome analysis provides a comprehensive characterization of regulatory circuits involving transcription factors, mRNAs, miRNAs and lncRNAs. To analyse the putative functions of these largely unknown RNA molecules, we developed a pipeline to integrate small and large RNA-seq data from multiple public databases and our own experiments. This led to the identification of the RNA interactome of glioblastoma and allowed us to define regulatory loops mediated by lncRNAs. We identified 22 key lncRNAs involved in transcriptional regulatory motifs, and three lncRNAs associated with patient prognosis, independent of other known response predictors. The investigation of TMZ-induced molecular networks in glioblastoma highlights novel coding and non-coding RNA-based predictors of glioblastoma chemoresistance, as well as potential targets to counteract such resistance.","gpl":"16791","gse":"98126","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2019/04/24","suppfile":"TXT","samples":[{"accession":"GSM2587591","title":"SAB-09 (RNA-seq)"},{"accession":"GSM2587588","title":"SAB-06 (RNA-seq)"},{"accession":"GSM2587585","title":"SAB-03 (RNA-seq)"},{"accession":"GSM2587605","title":"SAB-23 (RNA-seq)"},{"accession":"GSM2587597","title":"SAB-15 (RNA-seq)"},{"accession":"GSM2587594","title":"SAB-12 (RNA-seq)"},{"accession":"GSM2587603","title":"SAB-21 (RNA-seq)"},{"accession":"GSM2587583","title":"SAB-01 (RNA-seq)"},{"accession":"GSM2587600","title":"SAB-18 (RNA-seq)"},{"accession":"GSM2587606","title":"SAB-24 (RNA-seq)"},{"accession":"GSM2587586","title":"SAB-04 (RNA-seq)"},{"accession":"GSM2587592","title":"SAB-10 (RNA-seq)"},{"accession":"GSM2587601","title":"SAB-19 (RNA-seq)"},{"accession":"GSM2587598","title":"SAB-16 (RNA-seq)"},{"accession":"GSM2587589","title":"SAB-07 (RNA-seq)"},{"accession":"GSM2587595","title":"SAB-13 (RNA-seq)"},{"accession":"GSM2587584","title":"SAB-02 (RNA-seq)"},{"accession":"GSM2587587","title":"SAB-05 (RNA-seq)"},{"accession":"GSM2587604","title":"SAB-22 (RNA-seq)"},{"accession":"GSM2587593","title":"SAB-11 (RNA-seq)"},{"accession":"GSM2587590","title":"SAB-08 (RNA-seq)"},{"accession":"GSM2587596","title":"SAB-14 (RNA-seq)"},{"accession":"GSM2587602","title":"SAB-20 (RNA-seq)"},{"accession":"GSM2587599","title":"SAB-17 (RNA-seq)"}],"relations":[],"extrelations":[{"relationtype":"SRA","targetobject":"SRP105292","targetftplink":"ftp://ftp-trace.ncbi.nlm.nih.gov/sra/sra-instant/reads/ByStudy/sra/SRP/SRP105/SRP105292/"}],"n_samples":24,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":[],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE98nnn/GSE98126/","geo2r":"yes","bioproject":"PRJNA384285"},"200129475":{"uid":"200129475","accession":"GSE129475","gds":"","title":"Gene expression profile between ARID1A knockdown SAS cells and mock SAS cells","summary":"The aim of the study was to elucidate the character of ARID1A by a comprehensive gene expression analysis.","gpl":"16686","gse":"129475","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by array","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2019/04/09","suppfile":"CEL, CHP, XLSX","samples":[{"accession":"GSM3713547","title":"SAS 109"},{"accession":"GSM3713548","title":"SAS NC"},{"accession":"GSM3713546","title":"SAS 108"}],"relations":[],"extrelations":[],"n_samples":3,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":[],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE129nnn/GSE129475/","geo2r":"yes","bioproject":"PRJNA531455"},"200125033":{"uid":"200125033","accession":"GSE125033","gds":"","title":"ChIP-Seq analysis of SMARCA4 binding sites in human NSC","summary":"We performed large-scale, pooled shRNA screens targeting 538 epigenetic regulators in genetically identical human stem cells, where each gene was targeted on avarage by 12 shRNAs. CD34+ HSPCs, used as a starting point of the study, were reprogrammed to iPSCs, which were differentiated to NSC. These cells were transduced with the pooled shRNA library and samples were collected 2 days post transduction (dpt), 12 dpt, and 22dpt - allowing 5 cell doublings. PCR amplified gDNA carrying the shRNA barcodes was sequenced on a HiSeq2500 Illumina sequencer. Analysis of NGS results, based on the change of shRNA representation (read count) and represented by z-scores, identified SMARCA4 as a differential regulator (SMARCA4 shRNAs were depleted in HSPC vs enriched in NSC sreens). We performed RNA-seq experiments as part of the characterization dataset for the isogenic HSPC, HSPC-derived iPSC, and iPSC-derived NSC. RNA samples from CD34+ HSPC were harvested in parallel to gDNA isolation on 12- and 22-days post transduction, during the RNAi screen. In addition, untreated iPSC and NSC RNA samples were sequenced as part of their characterization. RNA samples were sequenced with poly-dT enrichment using single-end sequencing. Each sample was sequenced at a depth of yielding at least 20 million reads. We performed a ChIP-seq analysis of the SMARCA4 binding sites in hNSC, which we identified in the large-scale RNAi screens as a candidate, involved in regulation of self-renewal and differentiation. The pull-down experiment was performed on the untreated NSCs. We show that SMARCA4 has a prominent binding tendency for the TSS throughout the genome, suggesting a role for SMARCA4 in transcriptional regulation.","gpl":"16791","gse":"125033","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Genome binding/occupancy profiling by high throughput sequencing; Expression profiling by high throughput sequencing; Other","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2019/04/09","suppfile":"BIGWIG, TXT","samples":[{"accession":"GSM3561457","title":"Input ChIP-Seq (NSC)"},{"accession":"GSM3561460","title":"iPSC RNA-Seq"},{"accession":"GSM3561456","title":"SMARCA4 ChIP-Seq (NSC)"},{"accession":"GSM3561459","title":"HSPC CD34+ day 22 RNA-Seq"},{"accession":"GSM3561465","title":"HSPC CD34- shRNA screen (day 12)"},{"accession":"GSM3561468","title":"NSC shRNA screen (day 12)"},{"accession":"GSM3561462","title":"HSPC CD34+ shRNA screen (day 2)"},{"accession":"GSM3561464","title":"HSPC CD34+ shRNA screen (day 22)"},{"accession":"GSM3561467","title":"NSC shRNA screen (day 2)"},{"accession":"GSM3561458","title":"HSPC CD34+ day 12 RNA-Seq"},{"accession":"GSM3561463","title":"HSPC CD34+ shRNA screen (day 12)"},{"accession":"GSM3561461","title":"NSC RNA-Seq"},{"accession":"GSM3561466","title":"HSPC CD34- shRNA screen (day 22)"},{"accession":"GSM3561469","title":"NSC shRNA screen