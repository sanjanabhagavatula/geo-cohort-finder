69","title":"UT14 xenograft_Post irradiation_Day 21_Replicate 2"},{"accession":"GSM1508665","title":"UT14 xenograft_Post irradiation_Day 7_Replicate 2"},{"accession":"GSM1508662","title":"UT14 xenograft_Post irradiation_Day 4_Replicate 1"},{"accession":"GSM1508654","title":"UT14 xenograft_Untreated Control_Day 0_Replicate 1"},{"accession":"GSM1508668","title":"UT14 xenograft_Post irradiation_Day 21_Replicate 1"},{"accession":"GSM1508667","title":"UT14 xenograft_Post irradiation_Day 12_Replicate 2"},{"accession":"GSM1508659","title":"UT14 xenograft_Untreated Control_Day 3_Replicate 2"}],"relations":[],"extrelations":[],"n_samples":15,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":["25245558","25304950","26880935"],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE61nnn/GSE61573/","geo2r":"yes","bioproject":"PRJNA261512"},"200061495":{"uid":"200061495","accession":"GSE61495","gds":"","title":"Overcoming cetuximab resistance in HNSCC: The role of AURKB and DUSP proteins","summary":"Unraveling the underlying mechanisms of cetuximab resistance in head and neck squamous cell carcinoma (HNSCC) is of major importance as many tumors remain non-responsive or become resistant. Out microarray results suggest that resistant cells still exhibit RAS-MAPK pathway signaling contributing to drug resistance, as witnessed by low expression of DUSP 5 and DUSP6, negative regulators of ERK1/2, and increased expression of AURKB, a key regulator of mitosis. Therefore, interrupting the RAS-MAPK pathway by an ERK1/2 inhibitor  (apigenin) or an AURKB inhibitor (barasertib) might be  a new strategy for overcoming cetuximab resistance in HNSCC","gpl":"10558","gse":"61495","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by array","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2014/09/18","suppfile":"TXT","samples":[{"accession":"GSM1506268","title":"LICR_HN2_PBS2"},{"accession":"GSM1506274","title":"LICR