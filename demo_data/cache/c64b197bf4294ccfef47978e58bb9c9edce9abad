sapiens","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2022/07/03","suppfile":"TXT","samples":[{"accession":"GSM6278773","title":"CAL27 cells Metformin 30mM replicate 3"},{"accession":"GSM6278768","title":"CAL27 cells Control PBS replicate 1"},{"accession":"GSM6278771","title":"CAL27 cells Metformin 30mM replicate 1"},{"accession":"GSM6278772","title":"CAL27 cells Metformin 30mM replicate 2"},{"accession":"GSM6278770","title":"CAL27 cells Control PBS replicate 3"},{"accession":"GSM6278769","title":"CAL27 cells Control PBS replicate 2"}],"relations":[],"extrelations":[],"n_samples":6,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":["36738487"],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE207nnn/GSE207122/","geo2r":"yes","bioproject":"PRJNA853763"},"200168271":{"uid":"200168271","accession":"GSE168271","gds":"","title":"Analysis of EHF Regulated Network in HNSCC Cell Lines","summary":"We evaluated the gene expression changes upon the loss and gain of EHF in HNSCC cells","gpl":"24676;16791","gse":"168271","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing; Genome binding/occupancy profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2022/06/08","suppfile":"BW, TXT, XLSX","samples":[{"accession":"GSM5135360","title":"SCC25 Control Cells Rep1 mRNA"},{"accession":"GSM5135363","title":"SCC25 EHF Expressed Rep2 mRNA"},{"accession":"GSM5135349","title":"A253 EHF Expressing Rep1 mRNA"},{"accession":"GSM5135346","title":"A253 EHF Control Rep1 mRNA"},{"accession":"GSM5135352","title":"CAL27 EHF ChIP"},{"accession":"GSM5135361","title":"SCC25 Control Cells Rep2 mRNA"},{"accession":"GSM5135358","title":"CAL27 Control Cells Rep1 mRNA"},{"accession":"GSM5135355","title":"CAL27 EHF Knockdown Cells 1 Rep2 mRNA"},{"accession":"GSM