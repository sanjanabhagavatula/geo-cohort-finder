<?xml version="1.0"  ?><!DOCTYPE pmc-articleset PUBLIC "-//NLM//DTD ARTICLE SET 2.0//EN" "https://dtd.nlm.nih.gov/ncbi/pmc/articleset/nlm-articleset-2.0.dtd"><pmc-articleset><article article-type="research-article" xml:lang="en" dtd-version="1.4"><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Cell Rep Med</journal-id><journal-id journal-id-type="iso-abbrev">Cell Rep Med</journal-id><journal-id journal-id-type="pmc-domain-id">3954</journal-id><journal-id journal-id-type="pmc-domain">cellrepsmed</journal-id><journal-id journal-id-type="nlm-id">101766894</journal-id><journal-title-group><journal-title>Cell Reports Medicine</journal-title></journal-title-group><issn pub-type="epub">2666-3791</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC13130666</article-id><article-id pub-id-type="pmcid-ver">PMC13130666.1</article-id><article-id pub-id-type="pmcaid">13130666</article-id><article-id pub-id-type="pmcaiid">13130666</article-id><article-id pub-id-type="pmid">41923630</article-id><article-id pub-id-type="doi">10.1016/j.xcrm.2026.102715</article-id><article-id pub-id-type="pii">S2666-3791(26)00132-1</article-id><article-id pub-id-type="publisher-id">102715</article-id><article-version article-version-type="pmc-version">1</article-version><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Single-cell analysis highlights the significance of malignant cell IFN/MHC-II for immunotherapy response in head and neck squamous cell carcinoma</article-title></title-group><contrib-group><contrib contrib-type="author" id="au1"><name name-style="western"><surname>Mints</surname><given-names initials="M">Michael</given-names></name><xref rid="aff1"