ts.","gpl":"28038","gse":"260789","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2025/06/27","suppfile":"TSV","samples":[{"accession":"GSM8124633","title":"LM Parental"},{"accession":"GSM8124630","title":"LM CDK2AP1 KO, Clone B4"},{"accession":"GSM8124628","title":"CA1 CDK2AP1 KO, Clone G3"},{"accession":"GSM8124631","title":"LM CDK2AP1 KO, Clone B6"},{"accession":"GSM8124626","title":"CA1 CDK2AP1 KO, Clone A11"},{"accession":"GSM8124632","title":"LM CDK2AP1 KO, Clone H4"},{"accession":"GSM8124629","title":"CA1 Parental"},{"accession":"GSM8124627","title":"CA1 CDK2AP1 KO, Clone B3"}],"relations":[],"extrelations":[],"n_samples":8,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":["40112045"],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE260nnn/GSE260789/","geo2r":"no","bioproject":"PRJNA1083503"},"200290468":{"uid":"200290468","accession":"GSE290468","gds":"","title":"STAMP: Single-Cell Transcriptomics Analysis and Multimodal Profiling through Imaging","summary":"This SuperSeries is composed of the SubSeries listed below.  PhenoCycler (protein) data is available at https://stjude.app.box.com/s/fg5e5r43heipjh6lchu6m0d612ojwtw1 This is the content within the .tar file: There are 3 STAMPs on the slide i) {PBMC, MCF-7, SK-BR-3}, ii) {MCF-7}, and iii) {SK-BR-3}.You can separate each STAMP by referring to stamp12b_MCF7_new.tsv and stamp12b_SKBR3.tsv - the remaining stamp in the slide will be {PBMC, MCF-7, SK-BR-3}.","gpl":"34284;33484;33896;31217;33762","gse":"290468","taxon":"Mus musculus; synthetic construct; Homo sapiens","entrytype":"GSE","gdstype":"Other; Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2025/06/23","suppfile":"CSV, MTX, PARQUET, QS, TSV","samples":[{"accession":"GSM8814965","title":"STAMP_36"},{"accession":"GSM881