tential.","gpl":"24676","gse":"298321","taxon":"Homo sapiens","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2025/06/02","suppfile":"TXT","samples":[{"accession":"GSM9012017","title":"FaDu cells, Compound4, control, biol repl3"},{"accession":"GSM9012015","title":"FaDu cells, Compound4, control, biol repl1"},{"accession":"GSM9012012","title":"FaDu cells, Control, control, biol repl1"},{"accession":"GSM9012016","title":"FaDu cells, Compound4, control, biol repl2"},{"accession":"GSM9012013","title":"FaDu cells, Control, control, biol repl2"},{"accession":"GSM9012014","title":"FaDu cells, Control, control, biol repl3"}],"relations":[],"extrelations":[],"n_samples":6,"seriestitle":"","platformtitle":"","platformtaxa":"","samplestaxa":"","pubmedids":[],"projects":[],"ftplink":"ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE298nnn/GSE298321/","geo2r":"no","bioproject":"PRJNA1268948"},"200266475":{"uid":"200266475","accession":"GSE266475","gds":"","title":"Transcriptomic analysis after proton and neutron therapy","summary":"Study of molecular signatures in three types of objects after proton (human) and neutron (cell model, xenograft) irradiation","gpl":"16791;17021","gse":"266475","taxon":"Homo sapiens; Mus musculus","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2025/05/01","suppfile":"CSV","samples":[{"accession":"GSM8247903","title":"head and neck tumor after proton therapy mouse 2"},{"accession":"GSM8247906","title":"head and neck normal tissue before proton therapy human 1"},{"accession":"GSM8247895","title":"head and neck tumor after proton therapy cell 1"},{"accession":"GSM8247912","title":"head and neck tumor after proton therapy human 2"},{"accession":"GSM8247909","title":"head and neck tumor after proton therapy human 1"},{"accession":"GSM8247915","title":"head and neck tumor 